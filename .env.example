# Copy to .env and edit. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Optional comma-separated HTTPS origins trusted for CSRF in production.
DJANGO_CSRF_TRUSTED_ORIGINS=
# Enable HTTPS redirects when DEBUG is False.
DJANGO_SECURE_SSL_REDIRECT=True

# Set DATABASE_URL to a PostgreSQL connection URL in production.
DATABASE_URL=
# Optional SQLite path for local development only. Leave empty to use db.sqlite3.
DJANGO_DB_PATH=

# Vercel Blob adds this token when a store is connected to the project.
# Leave blank locally to keep using filesystem storage.
BLOB_READ_WRITE_TOKEN=

# Public base URL, used for links in emails. Leave unset on Vercel to use its deployment URL.
SITE_URL=http://127.0.0.1:8000

# Staff emails notified of new submissions and reports (comma separated, optional).
MODERATOR_EMAILS=

# Email configuration. The console backend does not send email; set SMTP values to enable it.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=KULOSA <no-reply@localhost>
