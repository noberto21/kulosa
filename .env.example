# Copy to .env and edit. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Optional comma-separated HTTPS origins trusted for CSRF in production.
DJANGO_CSRF_TRUSTED_ORIGINS=

# SQLite database file. Leave empty to use db.sqlite3 in the project folder.
# In production, point this at a path outside the project, e.g. /var/lib/kulosa/db.sqlite3
DJANGO_DB_PATH=

# Public base URL, used for links in emails.
SITE_URL=http://127.0.0.1:8000

# Staff emails notified of new submissions and reports (comma separated, optional).
MODERATOR_EMAILS=
