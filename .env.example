# Copy to .env and edit. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Optional: use managed PostgreSQL by setting DATABASE_URL.
# For local SQLite, leave both variables below empty.
DATABASE_URL=

# Optional SQLite database file path (local development only).
DJANGO_DB_PATH=

# Public base URL, used for links in emails.
SITE_URL=http://127.0.0.1:8000

# Staff emails notified of new submissions and reports (comma separated, optional).
MODERATOR_EMAILS=
